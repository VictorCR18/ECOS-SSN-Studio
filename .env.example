# Copie este arquivo para ".env" na raiz do projeto e preencha o que for
# usar. Nunca commite um ".env" real com chaves preenchidas (já está no
# .gitignore).
#
#   cp .env.example .env

# ── Backend (server/index.ts) ────────────────────────────────────────────
# O backend usa estas chaves como fallback quando o painel não envia uma chave.
# Nunca compartilhe nem versione um arquivo .env preenchido.

# Chaves usadas no teste do TCC
GEMINI_API_KEY=
NVIDIA_API_KEY=
GROQ_API_KEY=

# Outros provedores opcionais
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Porta em que a API (Express) escuta. Padrão: 3001.
PORT=3001

# ── Frontend (Vite) ───────────────────────────────────────────────────────
# Opcional: só é necessário se o frontend for hospedado separadamente do
# backend (ex.: frontend na Vercel, backend em outro host). Em
# desenvolvimento local e quando o backend serve o próprio build de
# produção (npm start), deixe em branco.
VITE_API_BASE_URL=
