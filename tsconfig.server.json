{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "server/**/*.ts",
    "src/types/ssn.ts",
    "src/types/llm.ts",
    "src/services/promptBuilder.ts",
    "src/services/effortService.ts",
    "src/services/modelSelector.ts",
    "src/data/ssnKnowledge.ts",
    "src/utils/jsonExtractor.ts",
    "src/utils/ssnValidator.ts"
  ]
}
